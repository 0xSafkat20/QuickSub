# Private backend configuration. Never use VITE_ prefixes for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=4000
# PUBLIC_ORIGIN=https://your-domain.example
# TRUST_PROXY_HOPS=1

# Online payments: start in sandbox; PUBLIC_ORIGIN must be your public HTTPS URL.
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Long random secret for POST /api/payments/jobs from your scheduler.
PAYMENT_JOB_SECRET=
# Optional payment receipt emails (verified sender required).
RESEND_API_KEY=
PAYMENT_RECEIPT_FROM=
# Optional local demo packages when a product has no real packages. Never charges money.
QUICKSUB_DEMO_CHECKOUT=false
