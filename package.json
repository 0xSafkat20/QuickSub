{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "knowledge": "node scripts/build-knowledge.mjs",
    "predev": "npm run knowledge",
    "prebuild": "npm run knowledge",
    "start": "node server/index.js",
    "test:chat": "node --test server/chat.test.js server/catalog.test.js",
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "db:seed": "npm run knowledge && node scripts/seed-supabase.mjs",
    "test:admin": "node --test scripts/admin.integration.test.mjs scripts/admin.boundary.test.mjs",
    "check:admin": "node scripts/check-admin.mjs",
    "check:checkout": "node scripts/check-checkout.mjs",
    "check:payments": "node scripts/check-payments.mjs",
    "test:payments": "node --test server/payments.test.js scripts/payments.integration.test.mjs",
    "test": "node --test server/*.test.js scripts/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=90 server/*.test.js scripts/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --browser",
    "check:accounts": "node scripts/check-accounts.mjs",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:navigation": "node scripts/check-navigation.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
